# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/greenland-estates?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Auth / JWT  (generate a long random string, e.g. `openssl rand -hex 32`)
# ---------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---------------------------------------------------------------------------
# Cloudinary (optional). Leave blank to run in local mode: uploaded images are
# stored as inline data URIs instead. Fine for demos, NOT for production volume.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Seed credentials — used only by `npm run seed` to create the first admin.
# Change these before your first deploy.
# ---------------------------------------------------------------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@greenlandestates.com
ADMIN_PASSWORD=ChangeMe@123

# ---------------------------------------------------------------------------
# Public site config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Fallbacks used if the SiteSettings document is missing
WHATSAPP_NUMBER=91XXXXXXXXXX

# Environment
NODE_ENV=development
